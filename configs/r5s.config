# ImmortalWrt 24.10 / NanoPi R5S (RK3568)
# 用途：主路由 + 科学上网 + NAS/Docker，刷 eMMC (32GB)

# ================= Target =================
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
# TARGET_DEVICE_* 符号位于 depends on TARGET_MULTI_PROFILE 的菜单内，
# 不开这个开关 make defconfig 会直接丢弃下面那行（见 scripts/target-metadata.pl:267）
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y

# ================= 镜像 =================
# squashfs：只读基底 + overlay。Docker 数据不放 overlay（overlayfs 套 overlayfs
# 会因为 trusted.overlay.* xattr 被拒而降级，opaque dir 失效），而是刷完机后在
# eMMC 剩余空间手动建分区 3，挂载后把 dockerd 的 data_root 指过去。
#
# !!! ROOTFS_PARTSIZE 一旦定下就不要再改 !!!
# rockchip 的 platform_do_upgrade 会比对镜像与磁盘的分区表，一致时只逐分区写入
# （保住分区 3），不一致时整盘 dd（分区 3 连同数据全没）。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_KERNEL_PARTSIZE=64

# ================= 全量 kmod（供本地离线源）=================
CONFIG_ALL_KMODS=y

# ================= 语言 / 主题 =================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ================= 代理 =================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_mihomo-meta=y

# ================= DNS =================
CONFIG_PACKAGE_luci-app-mosdns=y

# ================= Docker =================
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# ================= NAS / 存储 =================
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_dosfstools=y

# ================= 网络 / 加速 =================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ================= 广告过滤 =================
# 后端 adguardhome 用 feed 自带的，界面来自 sirpdboy 的 js 分支（见 diy-part1.sh）
CONFIG_PACKAGE_luci-app-adguardhome=y

# ================= 远程访问 / 组网 =================
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-frpc=y

# ================= 下载 =================
CONFIG_PACKAGE_luci-app-aria2=y

# ================= 监控 / 运维 =================
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-app-eqos=y

# ================= 多线接入 =================
# R5S 三个网口，双宽带时做负载均衡/故障切换
CONFIG_PACKAGE_luci-app-mwan3=y

# ================= VPN =================
# WireGuard 走 luci-proto-wireguard（在 luci feed 的 protocols/ 目录）。
# luci-app-wireguard 已被取代且不在 feed 里，那个只是只读状态面板；
# proto 插件才是在"网络→接口"里真正能建隧道的那个。
# 后两个是它的依赖，显式写出以便 verify-config.sh 盯住。
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_luci-app-openvpn-server=y

# ================= 存储扩展 =================
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-nfs=y
CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_luci-app-rclone=y

# ================= 下载 / 转发 =================
CONFIG_PACKAGE_luci-app-transmission=y
CONFIG_PACKAGE_luci-app-tinyproxy=y

# ================= 应用商店 =================
CONFIG_PACKAGE_luci-app-store=y

# ================= 常用工具 =================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_lsblk=y
