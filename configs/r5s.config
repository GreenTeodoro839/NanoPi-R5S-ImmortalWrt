# ImmortalWrt 24.10 / NanoPi R5S (RK3568)
# 用途：主路由 + 科学上网 + NAS/Docker，刷 eMMC (32GB)

# ================= Target =================
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
# TARGET_DEVICE_* 符号位于 depends on TARGET_MULTI_PROFILE 的菜单内，
# 不开这个开关 make defconfig 会直接丢弃下面那行（见 scripts/target-metadata.pl:267）
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y

# ================= 镜像 =================
# squashfs：只读基底 + overlay。Docker 数据不放 overlay（overlayfs 套 overlayfs
# 会因为 trusted.overlay.* xattr 被拒而降级，opaque dir 失效），而是刷完机后在
# eMMC 剩余空间手动建分区 3，挂载后把 dockerd 的 data_root 指过去。
#
# !!! ROOTFS_PARTSIZE 一旦定下就不要再改 !!!
# rockchip 的 platform_do_upgrade 会比对镜像与磁盘的分区表，一致时只逐分区写入
# （保住分区 3），不一致时整盘 dd（分区 3 连同数据全没）。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_KERNEL_PARTSIZE=64

# ================= 全量 kmod（供本地离线源）=================
CONFIG_ALL_KMODS=y

# ==== 构建加速（配合 CI 缓存） ====
# CCACHE 的 prompt 是 `bool "Use ccache" if DEVEL`（config/Config-devel.in:82），
# 没有 CONFIG_DEVEL=y 就没有 prompt，make defconfig 会把它悄悄丢掉。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CCACHE_DIR 留空 → rules.mk:346 用 $(TOPDIR)/.ccache
CONFIG_CCACHE_DIR=""
# Go 的构建缓存路径在 diy-part2.sh 里按 $PWD 写入（默认在 tmp/ 里，每次都会被清掉）


# ================= 语言 / 主题 =================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ================= 代理 =================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_mihomo-meta=y

# ================= DNS =================
CONFIG_PACKAGE_luci-app-mosdns=y

# ================= Docker =================
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# ================= NAS / 存储 =================
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_dosfstools=y

# ================= 网络 / 加速 =================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ================= 广告过滤 =================
# 后端 adguardhome 用 feed 自带的，界面来自 sirpdboy 的 js 分支（见 diy-part1.sh）
CONFIG_PACKAGE_luci-app-adguardhome=y

# ================= 远程访问 / 组网 =================
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-frpc=y

# ================= 下载 =================
CONFIG_PACKAGE_luci-app-aria2=y

# ================= 监控 / 运维 =================
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-app-eqos=y

# ================= 应用商店 =================
CONFIG_PACKAGE_luci-app-store=y

# ================= 常用工具 =================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
